rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(res) { return isAuth() && request.auth.uid == res.data.createdBy; }
    function isCollaborator(res) {
      return isAuth() && request.auth.uid in res.data.collaborators;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Trips ─────────────────────────────────────────────────────────────────
    // Public trips are readable by anyone. Only owner can delete.
    // Collaborators can update (add/remove spots, etc.) but not delete.
    // Legacy day-planner trips used `userId` field — allow get: true preserves
    // shared itinerary links from the old schema.
    match /trips/{tripId} {
      allow get: if resource.data.isPublic == true
                 || isOwner(resource)
                 || isCollaborator(resource);
      allow list: if isAuth() && (
                    resource.data.createdBy == request.auth.uid
                    || request.auth.uid in resource.data.collaborators
                  );
      allow create: if isAuth()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner(resource)
                    || (isCollaborator(resource)
                        && !request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasAny(['createdBy', 'collaborators', 'isPublic']));
      allow delete: if isOwner(resource);
    }

    // ── Spots ─────────────────────────────────────────────────────────────────
    match /spots/{spotId} {
      allow get, list: if isOwner(resource);
      allow create: if isAuth()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner(resource);
    }

    // ── Collections ───────────────────────────────────────────────────────────
    match /collections/{collectionId} {
      allow get: if resource.data.isPublic == true || isOwner(resource);
      allow list: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow create: if isAuth()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner(resource);
    }

    // ── Shares ────────────────────────────────────────────────────────────────
    // Anyone can read a share doc (that's the point of a share link).
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuth()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner(resource);
    }

    // ── Activity pool — public read, admin-only write (seed script) ───────────
    match /activities/{destination}/items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Invites — token-based; anyone can read to accept, auth can create ─────
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // ── Trip comments — auth users can read/add; delete own only ─────────────
    match /trips/{tripId}/comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
